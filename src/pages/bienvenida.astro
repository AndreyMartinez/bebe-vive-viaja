---
// Liga personal de cada viaje: /bienvenida/?viaje=<ref>. La comparte la organizadora desde el admin (apps-script/admin).
// Bienvenida + registro (punto de abordaje, personas, comprobante → Google Sheets vía apps-script/api) + políticas.
// La referencia va en el query porque los viajes se crean sin volver a publicar el sitio. No se indexa ni entra al sitemap.
import '../styles/global.css';
import { url } from '../lib/url';
import { site } from '../config/site';
import mandala from '../assets/brand/mandala.png';
import wordmark from '../assets/brand/wordmark.png';
import PoliticasCancelacion from '../components/PoliticasCancelacion.astro';
import Registro from '../components/islands/Registro';

const title = `Bienvenida al viaje · ${site.name}`;
const description = '¡Ya eres parte del viaje! Elige tu punto de abordaje, registra a quienes viajan y sube tu comprobante.';
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="bv">
    <header class="hero on-dark">
      <span class="logo wm" style={`--src:url(${mandala.src})`} aria-hidden="true"></span>
      <img class="brand" src={mandala.src} width={mandala.width} height={mandala.height} alt={site.name} />
      <p class="kicker label">Te damos la</p>
      <h1 class="brush">Bienvenida</h1>
      <p class="hello">¡Ya eres parte del viaje!</p>
      <p class="chip label" data-viaje-nombre hidden></p>
    </header>

    <main class="body">
      <p class="lead"><b>¡Gracias por tu apartado!</b> Completa estos 3 pasos para dejar listo tu lugar.</p>

      <Registro client:load api={site.registroApi} />

      <div class="pol">
        <div class="sect">
          <p class="kicker label">Políticas de</p>
          <h2 class="brush">Cancelación</h2>
        </div>
        <PoliticasCancelacion />
      </div>
    </main>

    <footer class="foot">
      <a href={url('/')} aria-label={`${site.name}, inicio`}><span class="logo word" style={`--src:url(${wordmark.src})`}></span></a>
      <a class="ig" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">@{site.instagram}</a>
    </footer>
  </body>
</html>

<style>
  .bv { background: var(--sand); color: var(--ink); }
  .brush { font-family: var(--brush); font-weight: 400; }

  /* ---------- Portada ---------- */
  .hero {
    position: relative; overflow: hidden; text-align: center;
    background: var(--black); color: var(--white);
    padding: 40px var(--gutter) 52px;
  }
  .wm {
    position: absolute; left: 50%; top: -12%; transform: translateX(-50%);
    width: min(140%, 900px); aspect-ratio: 456 / 290; color: var(--white); opacity: 0.07;
  }
  .brand { position: relative; display: block; margin: 0 auto; width: min(56vw, 240px); height: auto; filter: invert(1); }
  .kicker {
    position: relative; margin-top: 18px;
    display: inline-flex; align-items: center; gap: 14px;
    font-size: 12px; letter-spacing: 0.5em; padding-left: 0.5em;
  }
  .kicker::before, .kicker::after { content: ''; width: 48px; height: 1px; background: rgba(255, 255, 255, 0.5); }
  h1 { position: relative; font-size: clamp(56px, 12vw, 96px); line-height: 1.05; }
  .hello { position: relative; margin-top: 6px; font-size: clamp(16px, 3.6vw, 20px); font-weight: 500; }
  .chip {
    position: relative; display: inline-block; margin-top: 18px;
    border: 1px solid rgba(255, 255, 255, 0.35); border-radius: 999px; padding: 8px 18px; letter-spacing: 0.1em;
  }
  .chip[hidden] { display: none; }

  /* ---------- Contenido ---------- */
  .body { max-width: 1120px; margin: 0 auto; padding: 36px var(--gutter) 56px; display: flex; flex-direction: column; gap: 24px; }
  .lead { text-align: center; color: var(--ink-2); font-size: 16px; line-height: 1.5; }
  .lead b { color: var(--ink); font-weight: 600; }

  .pol { width: 100%; max-width: 820px; margin: 28px auto 0; display: flex; flex-direction: column; }
  .sect { text-align: center; }
  .sect .kicker { margin-top: 0; color: var(--ink-2); }
  .sect .kicker::before, .sect .kicker::after { background: var(--sand-line); }
  .sect h2 { margin-bottom: 4px; font-size: clamp(44px, 9vw, 64px); line-height: 1.1; }

  .foot {
    max-width: 1120px; margin: 0 auto; padding: 24px var(--gutter) 40px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    border-top: 1px solid var(--sand-line);
  }
  .word { display: block; width: 150px; aspect-ratio: 1242 / 370; color: var(--black); }
  .ig { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-decoration: none; font-weight: 500; }
  .ig:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 640px) {
    .foot { flex-direction: column; text-align: center; }
  }
</style>

<style is:global>
  /* Isla Registro.tsx (React no recibe estilos con scope de Astro). Todo bajo prefijo .reg- */
  .reg { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .reg-pasos { flex: 999 1 540px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .reg-lado { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 16px; position: sticky; top: 16px; }

  .reg-paso, .reg-aviso {
    background: var(--white); border: 1px solid var(--sand-line); border-radius: 18px; padding: 22px;
    display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 24px;
  }
  .reg-paso h2 { display: flex; align-items: baseline; gap: 12px; font-size: 20px; font-weight: 700; line-height: 1.2; }
  .reg-paso .n { font-family: var(--mono); font-size: 13px; font-weight: 400; color: var(--wine); letter-spacing: 0.1em; }
  .reg-ayuda { font-size: 14px; color: var(--ink-2); line-height: 1.4; }
  .reg-vacio { font-size: 14px; line-height: 1.5; color: var(--ink-2); background: #faf7f1; border: 1px dashed #cfc6b4; border-radius: 12px; padding: 14px; }

  .reg-aviso { max-width: 640px; width: 100%; margin: 0 auto; text-align: center; align-items: center; }
  .reg-aviso h2 { font-size: 19px; font-weight: 700; }
  .reg-aviso p { font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  .reg-aviso.dark { background: var(--black); color: var(--white); border-color: var(--black); }
  .reg-aviso.dark .label { color: #f0b9c0; }
  .reg-aviso.dark p { color: var(--white); }

  .reg fieldset { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  .reg-parada {
    display: flex; gap: 12px; align-items: flex-start; cursor: pointer;
    border: 1.5px solid var(--sand-line); background: var(--white); border-radius: 12px; padding: 14px;
  }
  .reg-parada.on { border-color: var(--wine); background: var(--wine-soft); }
  .reg-parada input { margin: 3px 0 0; width: 18px; height: 18px; accent-color: var(--wine); flex: none; }
  .reg-parada span { display: flex; flex-direction: column; gap: 3px; }
  .reg-parada b { font-size: 15px; font-weight: 600; line-height: 1.3; }
  .reg-parada small { font-size: 13px; color: var(--ink-2); line-height: 1.35; }

  .reg-mapa { display: flex; flex-direction: column; gap: 6px; }
  .reg-mapa iframe { display: block; width: 100%; height: 220px; border: 1px solid var(--sand-line); border-radius: 14px; background: #e9e4d8; }
  .reg-mapa-escritorio iframe { height: 300px; border-radius: 18px; }
  .reg-mapa a, .reg-total a { align-self: flex-start; display: inline-flex; align-items: center; min-height: 40px; font-size: 14px; font-weight: 600; color: var(--wine); text-underline-offset: 3px; }

  .reg-personas { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .reg-campo { display: flex; flex-direction: column; gap: 6px; }
  .reg-campo .label { letter-spacing: 0.1em; color: var(--ink-2); }
  .reg-campo small { font-size: 12px; color: var(--ink-2); }
  .reg-fila { display: flex; gap: 8px; }
  .reg-fila input { flex: 1; min-width: 0; }
  .reg input[type='text'], .reg input[type='tel'] {
    width: 100%; height: 46px; border: 1px solid #cfc6b4; border-radius: 10px; padding: 0 12px;
    font: inherit; font-size: 16px; background: var(--white); color: var(--ink);
  }
  .reg input[aria-invalid='true'] { border: 1.5px solid var(--wine); }
  .reg-quitar { width: 46px; height: 46px; flex: none; border: 1px solid #cfc6b4; border-radius: 10px; background: var(--white); color: var(--ink-2); font-size: 20px; cursor: pointer; }
  .reg-agregar {
    align-self: flex-start; min-height: 44px; border: 1px dashed var(--wine); background: transparent; color: var(--wine);
    border-radius: 999px; padding: 0 18px; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .reg-tel { max-width: 320px; padding-top: 14px; border-top: 1px solid #efe8da; }
  .reg-err { font-size: 13px; font-weight: 600; color: var(--wine); }

  .reg-subir {
    border: 1.5px dashed #cfc6b4; background: #faf7f1; border-radius: 12px; padding: 24px 16px; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
  }
  .reg-subir svg { width: 28px; height: 28px; fill: none; stroke: var(--ink-2); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .reg-subir b { font-size: 15px; }
  .reg-subir small { font-size: 12px; color: var(--ink-2); }
  #comprobante:focus-visible + .reg-subir, #comprobante:focus-visible + .reg-archivo { outline: 2px solid var(--ink); outline-offset: 3px; }
  .reg-archivo { display: flex; align-items: center; gap: 12px; border: 1px solid var(--leaf-line); background: var(--leaf-soft); border-radius: 12px; padding: 12px; }
  .reg-archivo-ok { width: 44px; height: 44px; flex: none; border-radius: 8px; background: var(--white); display: grid; place-items: center; }
  .reg-archivo-ok svg, .reg-ok-icon svg { width: 22px; height: 22px; fill: none; stroke: var(--leaf); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .reg-archivo-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .reg-archivo-txt b { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .reg-archivo-txt small { font-size: 12px; color: var(--ink-2); }
  .reg-archivo button { min-height: 44px; padding: 0 10px; border: 0; background: transparent; color: var(--wine); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }

  .reg-total {
    background: var(--white); border: 1.5px solid var(--black); border-radius: 18px; box-shadow: 6px 6px 0 var(--black);
    padding: 22px; display: flex; flex-direction: column; gap: 12px;
  }
  .reg-total > .label { color: var(--ink-2); letter-spacing: 0.12em; }
  .reg-total-parada { display: flex; flex-direction: column; gap: 2px; }
  .reg-total-parada small { font-size: 13px; color: var(--ink-2); }
  .reg-total-parada b { font-size: 16px; }
  .reg-total-parada .falta { color: var(--ink-2); font-weight: 500; }
  .reg-total-row { display: flex; justify-content: space-between; font-size: 14px; border-top: 1px solid #efe8da; padding-top: 10px; }
  .reg-total-row span { color: var(--ink-2); }
  .reg-total-row b { font-family: var(--mono); font-weight: 500; }
  .reg-guardar { justify-content: center; min-height: 54px; font-size: 13px; }
  .reg-guardar:disabled { opacity: 0.55; cursor: not-allowed; }
  .reg-acepta { text-align: center; font-size: 12px; color: var(--ink-2); }
  .reg-fallo { display: flex; flex-direction: column; gap: 4px; background: var(--wine-soft); border: 1.5px solid var(--wine-line); border-radius: 12px; padding: 12px 14px; font-size: 14px; line-height: 1.45; }
  .reg-fallo b { color: var(--wine); }

  /* Mapa: en celular va dentro del paso 01; en escritorio, en la columna derecha */
  .reg-mapa-escritorio { display: none; }
  @media (min-width: 900px) {
    .reg-mapa-movil iframe { display: none; }
    .reg-mapa-escritorio { display: flex; }
  }

  /* Confirmación */
  .reg-ok { width: 100%; max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; scroll-margin-top: 24px; }
  .reg-ok-card {
    background: var(--white); border: 1.5px solid var(--black); border-radius: 18px; box-shadow: 6px 6px 0 var(--black);
    padding: 26px 22px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
  }
  .reg-ok-icon { width: 56px; height: 56px; border-radius: 50%; background: var(--leaf); display: grid; place-items: center; }
  .reg-ok-icon svg { width: 28px; height: 28px; stroke: var(--white); stroke-width: 2.4; }
  .reg-ok-card h2 { font-size: 42px; line-height: 1.1; }
  .reg-ok-card p { font-size: 15px; line-height: 1.5; color: var(--ink-2); margin-bottom: 6px; }
  .reg-ok-card .label { color: var(--ink-2); }
  .reg-folio { font-family: var(--mono); font-size: 26px; font-weight: 500; letter-spacing: 0.08em; }
  .reg-resumen { margin: 0; background: var(--white); border: 1px solid var(--sand-line); border-radius: 16px; padding: 4px 20px; }
  .reg-resumen > div { padding: 14px 0; border-bottom: 1px solid #efe8da; display: flex; flex-direction: column; gap: 6px; }
  .reg-resumen > div:last-child { border-bottom: 0; }
  .reg-resumen > div.row { flex-direction: row; justify-content: space-between; align-items: center; }
  .reg-resumen dt { color: var(--ink-2); }
  .reg-resumen dd { margin: 0; display: flex; flex-direction: column; gap: 3px; font-size: 15px; }
  .reg-resumen dd span { font-size: 15px; }
  .reg-resumen dd a { color: var(--wine); font-weight: 600; font-size: 14px; text-underline-offset: 3px; min-height: 40px; display: inline-flex; align-items: center; }
  .reg-pendiente { font-size: 13px !important; font-weight: 600; color: #7a4f00; background: #fbf1dc; border-radius: 999px; padding: 6px 12px; }
  .reg-nota { text-align: center; font-size: 13px; line-height: 1.5; color: var(--ink-2); }

  @media (max-width: 899px) {
    .reg-lado { position: static; }
  }
</style>
