---
// Página independiente (sin menú ni pie del sitio): se comparte por WhatsApp después de que el viajero paga su apartado.
// En pantalla abre con una bienvenida genérica al viaje; al imprimir solo quedan las políticas (así sale el PDF).
// No se indexa ni entra al sitemap. Su versión imprimible es public/politicas-de-cancelacion.pdf.
import '../styles/global.css';
import { url } from '../lib/url';
import { site } from '../config/site';
import mandala from '../assets/brand/mandala.png';
import PoliticasCancelacion from '../components/PoliticasCancelacion.astro';
import wordmark from '../assets/brand/wordmark.png';

const title = `Bienvenida al viaje · ${site.name}`;
const description = '¡Ya eres parte del viaje! Conoce los siguientes pasos y las políticas de cancelación de tu apartado.';
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="pc">
    <header class="hero on-dark">
      <span class="logo wm" style={`--src:url(${mandala.src})`} aria-hidden="true"></span>
      <img class="brand" src={mandala.src} width={mandala.width} height={mandala.height} alt={site.name} />
      <p class="emo" aria-hidden="true">✈️ 🐵 🌿 🍷</p>
      <p class="kicker label"><span class="screen">Te damos la</span><span class="print">Políticas de</span></p>
      <h1 class="brush"><span class="screen">Bienvenida</span><span class="print">Cancelación</span></h1>
      <p class="hello screen">¡Ya eres parte del viaje!</p>
    </header>

    <main class="body">
      <section class="welcome screen" aria-label="Bienvenida">
        <p class="intro"><b>¡Gracias por tu apartado!</b> Tu lugar ya está reservado y nos emociona que viajes con nosotros. Esto es lo que sigue:</p>
        <ol class="steps">
          <li><span class="n">01</span><span><b>Tu lugar está apartado.</b> Guarda este enlace: aquí tienes las condiciones de tu reserva.</span></li>
          <li><span class="n">02</span><span><b>Te escribimos por WhatsApp</b> con el punto de abordaje, la hora de salida y los últimos detalles.</span></li>
          <li><span class="n">03</span><span><b>Prepárate para disfrutar.</b> Revisa el itinerario y lo que hay que llevar en <a href={url('/viajes/')}>nuestros viajes</a>.</span></li>
        </ol>
      </section>

      <div class="sect screen">
        <p class="kicker label">Políticas de</p>
        <h2 class="brush">Cancelación</h2>
      </div>

      <p class="lead"><span class="screen">Antes de salir, léelas con calma: aplican para todos los viajeros.</span><span class="print"><b>¡Gracias por tu apartado!</b><br />Te compartimos nuestras políticas de cancelación.</span></p>

      <PoliticasCancelacion />
    </main>

    <footer class="foot">
      <a href={url('/')} aria-label={`${site.name}, inicio`}><span class="logo word" style={`--src:url(${wordmark.src})`}></span></a>
      <span class="emo-s" aria-hidden="true">✈️🐵🌿🍷</span>
      <a class="ig" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">@{site.instagram}</a>
    </footer>
  </body>
</html>

<style>
  /* Paleta de marca: ver .claude/skills/paleta-marca. Vino = lo que pierde el cliente, hoja = lo que recibe. */
  .pc { background: var(--sand); color: var(--ink); }
  .print { display: none; }
  .brush { font-family: var(--brush); font-weight: 400; }

  /* ---------- Portada ---------- */
  .hero {
    position: relative; overflow: hidden; text-align: center;
    background: var(--black); color: var(--white);
    padding: 40px var(--gutter) 56px;
  }
  .wm {
    position: absolute; left: 50%; top: -12%; transform: translateX(-50%);
    width: min(140%, 900px); aspect-ratio: 456 / 290; color: var(--white); opacity: 0.07;
  }
  /* <img> invertido en vez de máscara: los visores de PDF (Vista Previa) pintan mal la máscara en grande */
  .brand { position: relative; display: block; margin: 0 auto; width: min(62vw, 260px); height: auto; filter: invert(1); }
  .emo { position: relative; margin-top: 6px; font-size: 18px; letter-spacing: 0.4em; padding-left: 0.4em; }
  .kicker {
    position: relative; margin-top: 18px;
    display: inline-flex; align-items: center; gap: 14px;
    font-size: 12px; letter-spacing: 0.5em; padding-left: 0.5em;
  }
  .kicker::before, .kicker::after { content: ''; width: 48px; height: 1px; background: rgba(255, 255, 255, 0.5); }
  h1 { position: relative; font-family: var(--brush); font-size: clamp(56px, 12vw, 96px); line-height: 1.05; }

  .hello { position: relative; margin-top: 10px; font-size: clamp(16px, 3.6vw, 19px); font-weight: 500; }

  /* ---------- Bienvenida (solo pantalla) ---------- */
  .welcome { display: flex; flex-direction: column; gap: 18px; }
  .intro { text-align: center; color: var(--ink-2); font-size: 16px; line-height: 1.5; }
  .intro b { color: var(--ink); font-weight: 600; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .steps li {
    display: flex; gap: 16px; align-items: center;
    background: var(--white); border: 1px solid var(--sand-line); border-radius: 14px; padding: 14px 18px; font-size: 15px; line-height: 1.45;
  }
  .steps b { font-weight: 600; }
  .steps a { color: var(--wine); font-weight: 600; text-underline-offset: 3px; }
  .n { flex: none; font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--wine); }
  .sect { margin-top: 44px; text-align: center; }
  .sect .kicker { margin-top: 0; color: var(--ink-2); }
  .sect .kicker::before, .sect .kicker::after { background: var(--sand-line); }
  .sect h2 { margin: 0 0 10px; font-size: clamp(44px, 9vw, 64px); font-weight: 400; line-height: 1.05; }

  /* ---------- Contenido ---------- */
  .body { max-width: 820px; margin: 0 auto; padding: 36px var(--gutter) 48px; display: flex; flex-direction: column; }
  .lead { text-align: center; color: var(--ink-2); font-size: 16px; line-height: 1.5; }
  .lead b { color: var(--ink); font-weight: 600; }


  .foot {
    max-width: 820px; margin: 0 auto; padding: 24px var(--gutter) 40px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    border-top: 1px solid var(--sand-line);
  }
  .word { display: block; width: 150px; aspect-ratio: 1242 / 370; color: var(--black); }
  .emo-s { font-size: 16px; letter-spacing: 0.2em; }
  .ig { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-decoration: none; font-weight: 500; }
  .ig:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 640px) {
    .foot { flex-direction: column; text-align: center; }
  }

  /* ---------- Impresión: una hoja A4, de aquí sale el PDF ---------- */
  @media print {
    @page { size: A4; margin: 0; }
    .screen { display: none !important; }
    .print { display: inline; }
    html, body { width: 210mm; height: 297mm; overflow: hidden; }
    .pc { -webkit-print-color-adjust: exact; print-color-adjust: exact; position: relative; }
    .hero { padding: 7mm 18mm 7mm; }
    .wm { display: none; } /* la opacidad sobre máscara se rasteriza mal en algunos visores de PDF */
    .brand { width: 64mm; }
    .emo { font-size: 13pt; }
    h1 { font-size: 40pt; }
    .body { max-width: none; padding: 5mm 18mm 0; }
    .body { padding-top: 4mm; }
    .lead { font-size: 10.5pt; }
    .foot { position: absolute; left: 0; right: 0; bottom: 0; max-width: none; padding: 4mm 18mm; flex-direction: row; text-align: left; }
  }
</style>
