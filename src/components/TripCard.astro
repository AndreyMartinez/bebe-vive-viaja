---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import { shortDate, type Viaje } from '../lib/viajes';

interface Props {
  viaje: Viaje;
  index: number;
  past?: boolean;
}
const { viaje, index, past = false } = Astro.props;
const d = viaje.data;
---
<a class:list={['card', { past }]} href={url(`/viajes/${viaje.id}/`)}>
  <div class="img">
    <Image src={d.cover} alt={d.coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 560px" format="webp" />
    {d.status === 'lleno' && !past && <span class="badge">Lleno</span>}
  </div>
  <div class="meta label"><span>{String(index + 1).padStart(2, '0')}</span><span>{shortDate(d.date)} · {d.region}</span></div>
  <h3>{d.title} <em>&amp; {d.titleAccent}</em></h3>
  <p>{d.summary}</p>
  <span class="go label">{past ? 'Ver cómo fue' : 'Ver itinerario'} →</span>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; color: inherit; min-width: 0; }
  .img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 2px; background: var(--hair); }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .card:hover .img :global(img) { transform: scale(1.035); }
  .badge { position: absolute; top: 14px; left: 14px; background: var(--ink); color: #fff; font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; }
  .meta { display: flex; justify-content: space-between; gap: 10px; color: var(--ink-2); }
  h3 { font-family: var(--serif); font-size: clamp(32px, 3.4vw, 44px); line-height: 1; }
  h3 em { opacity: 0.7; }
  p { font-size: 15px; font-weight: 300; color: var(--ink-2); max-width: 52ch; }
  .go { margin-top: 4px; }
  .card:hover .go { text-decoration: underline; text-underline-offset: 4px; }
  .past .img { filter: grayscale(0.6); }
</style>
